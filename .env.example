# Copy to .env and fill in. Never commit a real .env.
# Postgres (docker) — backend uses DATABASE_URL below instead.
# Local dev without docker: DATABASE_URL=sqlite+aiosqlite:///./nodus.db

DATABASE_URL=postgresql+asyncpg://nodus:nodus@localhost:5432/nodus

# Any OpenAI-compatible chat-completions endpoint works:
# OpenAI, OpenRouter, Groq, Gemini (compat endpoint), Ollama, vLLM…
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional per-role overrides (default: same as LLM_MODEL)
LLM_DEBATE_MODEL=
LLM_GRAPH_MODEL=
LLM_MODERATOR_MODEL=

LLM_TIMEOUT_SEC=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
