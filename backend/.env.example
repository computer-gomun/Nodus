# Copy to backend/.env for local runs (or use root .env with docker compose).
DATABASE_URL=sqlite+aiosqlite:///./nodus.db
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_DEBATE_MODEL=
LLM_GRAPH_MODEL=
LLM_MODERATOR_MODEL=
LLM_TIMEOUT_SEC=60

# 진행 도우미가 "결론 낼 만큼 무르익었나"를 판단하는 주기(AI 턴). 0이면 자동 결론 없음.
CONCLUSION_CHECK_INTERVAL=5

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
